# AlgoBloom 2.0 Backend Server Template 🌸

PORT=3001
NODE_ENV=development

# JWT Authentication Secret (Replace with a secure random key in production)
JWT_SECRET=your-secret-botanical-key-here
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Persistence Path
DATABASE_URL=file:./data/db.json
